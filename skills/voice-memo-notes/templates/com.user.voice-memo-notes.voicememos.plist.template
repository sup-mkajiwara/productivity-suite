<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <!-- シェルスクリプトを直接起動せず、監視用アプリを経由する。
         ボイスメモの録音フォルダを読むには「フルディスクアクセス」が必要で、
         この許可はアプリバンドルに紐づくため（シェルには与えられない）。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-n</string>
        <string>-a</string>
        <string>__APP_PATH__</string>
    </array>

    <!-- 録音フォルダの変更で起動する。
         launchd がこのフォルダを監視できない場合に備え、下の StartInterval も併用する -->
    <key>WatchPaths</key>
    <array>
        <string>__WATCH_DIR__</string>
    </array>

    <!-- 保険の定期チェック（秒）。取りこぼしても最大この間隔で拾う -->
    <key>StartInterval</key>
    <integer>600</integer>

    <!-- 短時間の連続発火を抑制する（秒） -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <false/>

    <!-- launchd 経由の低いファイルディスクリプタ上限(256)対策 -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
    </dict>

    <!-- 文字起こしは CPU を長く使うため、他の作業を妨げないよう優先度を下げる -->
    <key>Nice</key>
    <integer>5</integer>
    <key>LowPriorityIO</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__LOG_PATH__</string>
    <key>StandardErrorPath</key>
    <string>__LOG_PATH__</string>
</dict>
</plist>
